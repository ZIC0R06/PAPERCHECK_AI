# ── Copy to .env and fill in. Never commit real keys. ─────────────────────────
# ── AI engine: LOCAL OLLAMA (default — no API key, no cloud) ─────────────────
# Install Ollama (https://ollama.com), then:   ollama pull llama3.2:3b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096
# OLLAMA_NUM_CTX=8192          # context window (Ollama's own default of 2048 truncates long documents)
# OLLAMA_KEEP_ALIVE=30m        # keep the model loaded between requests (faster)
# LLM_RETRIES=2                # extra attempts on connection errors / HTTP 5xx

# OPTIONAL cloud providers — leave empty to stay 100% local. Only used if you set LLM_PROVIDER to one of
# groq|claude|gemini|openai, or list them (comma separated) in LLM_FALLBACKS as backups to Ollama.
# LLM_FALLBACKS=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Handwritten answer sheets ─────────────────────────────────────────────────
# Default: local OCR (Tesseract) and EVERY handwritten answer is flagged for the teacher to compare with the
# original page. llama3.2:3b cannot read images. For LOCAL vision reading install a vision model
# (`ollama pull llama3.2-vision`) and set HANDWRITING_PROVIDER=ollama + HANDWRITING_OLLAMA_MODEL below.
# A cloud key (optional) also enables cloud vision.
HANDWRITING_PROVIDER=auto         # auto | ollama | anthropic | gemini | openai | groq | local
# HANDWRITING_OLLAMA_MODEL=llama3.2-vision
# HANDWRITING_CLAUDE_MODEL=claude-sonnet-5-5
# HANDWRITING_GEMINI_MODEL=gemini-2.5-flash
# HANDWRITING_OPENAI_MODEL=gpt-4.1-mini
# HANDWRITING_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # Windows, if not on PATH
MARKS_STEP=0.5                    # awarded marks are rounded to this step
OCR_VERIFY_BELOW=0.7              # handwriting-reading confidence below this → flagged for the teacher
AI_VERIFY_BELOW=0.6               # AI marking confidence below this → flagged

# Security
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:8501
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_SECONDS=900

# Database (SQLite by default; PostgreSQL example below)
# DATABASE_URL=postgresql://user:password@localhost:5432/papercheck
# Frontend → backend
API_BASE_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000   # backend URL as the student's BROWSER sees it
# AI Mentor
MENTOR_MAX_FILE_MB=15
MENTOR_UPLOAD_DIR=uploads/mentor_files

# Examination rules & branding
PASS_PERCENT=40                  # pass mark used for pass/fail, grades and analytics
UNIVERSITY_NAME=University Examination Department   # printed on PDFs and OMR sheets
# Demo data (admin/faculty/student test accounts, batch CSE2026A) — set 0 in production
SEED_DEMO_DATA=1
# File storage
SCAN_DIR=uploads/scans
OMR_DIR=uploads/omr
BACKUP_DIR=backups
BACKUP_KEEP=14
